{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "missing": [
        {
          "type": "cookie",
          "key": "authorized_user",
          "value": "true"
        }
      ],
      "destination": "/login.html"
    },
    {
      "source": "/api/proxy",
      "missing": [
        {
          "type": "cookie",
          "key": "authorized_user",
          "value": "true"
        }
      ],
      "destination": "/404"
    }
  ]
}
