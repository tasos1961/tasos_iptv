{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "missing": [
        {
          "type": "cookie",
          "key": "authorized_user",
          "value": "true"
        }
      ],
      "destination": "/login",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "cookie",
          "key": "authorized_user",
          "value": "true"
        }
      ],
      "destination": "/app",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/proxy",
      "missing": [
        {
          "type": "cookie",
          "key": "authorized_user",
          "value": "true"
        }
      ],
      "destination": "/404"
    }
  ]
}
